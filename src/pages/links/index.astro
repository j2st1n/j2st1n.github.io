---
import { SITE } from "@/config";
import { friends } from "@/data/friends";
import QuietLayout from "@/themes/quiet/layouts/QuietLayout.astro";
---

<QuietLayout
  title={`友邻 | ${SITE.title}`}
  description="欢迎链接。这里收录 bins.blog 的友邻与阅读推荐。"
  noindex={friends.length === 0}
>
  <main id="main-content" class="links-page">
    <header class="links-hero">
      <p class="links-kicker">Links</p>
      <h1>友邻</h1>
      <p class="links-intro">欢迎链接</p>
    </header>

    {
      friends.length > 0 ? (
        <ul class="friend-list" aria-label="友邻博客">
          {friends.map(friend => (
            <li>
              <a
                class="friend-link"
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${friend.name}（在新标签页打开）`}
              >
                <span class="friend-copy">
                  <span class="friend-name">{friend.name}</span>
                  <span class="friend-description">{friend.description}</span>
                </span>
                <span class="friend-destination" aria-hidden="true">
                  <span>{new URL(friend.url).hostname}</span>
                  <span class="friend-arrow">↗</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="links-empty">友邻名单还在整理，改日再来坐坐。</p>
      )
    }
  </main>
</QuietLayout>

<style>
  .links-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 2rem) 4rem;
  }

  .links-hero {
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .links-kicker {
    margin: 0 0 0.75rem;
    color: var(--text-tertiary);
    font-family: var(--font-code);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .links-hero h1 {
    margin: 0 0 1rem;
    color: var(--foreground);
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.015em;
  }

  .links-intro {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .friend-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-list li {
    border-bottom: 1px solid var(--border-color);
  }

  .friend-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 7.25rem;
    padding-block: 1.65rem;
    color: var(--foreground);
    text-decoration: none;
  }

  .friend-copy {
    min-width: 0;
  }

  .friend-name {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .friend-description {
    display: block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .friend-destination {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-tertiary);
    font-family: var(--font-code);
    font-size: 0.75rem;
  }

  .friend-arrow {
    font-size: 1.1rem;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .friend-link:hover .friend-name,
  .friend-link:focus-visible .friend-name {
    color: var(--accent);
  }

  .friend-link:hover .friend-arrow,
  .friend-link:focus-visible .friend-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .links-empty {
    margin: 1.5rem 0 0;
    color: var(--text-tertiary);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .links-page {
      padding: 1.5rem 1rem 3rem;
    }

    .links-hero {
      padding-bottom: 2rem;
    }

    .friend-link {
      align-items: flex-start;
      gap: 1rem;
      padding-block: 1.4rem;
    }

    .friend-destination {
      margin-top: 0.15rem;
    }

    .friend-destination > span:first-child {
      display: none;
    }
  }
</style>
