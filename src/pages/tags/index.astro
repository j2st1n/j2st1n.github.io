---
import QuietLayout from "@/themes/quiet/layouts/QuietLayout.astro";
import getPostsByTag from "@/utils/getPostsByTag";
import getUniqueTags from "@/utils/getUniqueTags";
import { getPublishedPosts } from "@/utils/getPublishedPosts";
import { formatFullDate } from "@/utils/date";
import { SITE } from "@/config";
const posts = await getPublishedPosts();
const tags = getUniqueTags(posts);

const tagSummaries = tags
  .map(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    const latestPost = tagPosts[0];

    return {
      tag,
      tagName,
      count: tagPosts.length,
      latestPost,
    };
  })
  .sort((tagA, tagB) => {
    if (tagB.count !== tagA.count) return tagB.count - tagA.count;
    return tagA.tagName.localeCompare(tagB.tagName);
  });

const latestDate = posts.length
  ? formatFullDate(
      posts
        .map(post => post.data.modDatetime ?? post.data.pubDatetime)
        .sort((dateA, dateB) => dateB.getTime() - dateA.getTime())[0],
      SITE.timezone
    )
  : "";
---

<QuietLayout
  title={`标签 | ${SITE.title}`}
  description="所有文章标签的轻量索引。"
>
  <main id="main-content" class="tags-page">
    <header class="tags-hero">
      <p class="tags-kicker">Tags</p>
      <h1>主题索引</h1>
      <p>
        共 {tagSummaries.length} 个主题
        <span> · {posts.length} 篇文章</span>
        {latestDate && <span> · 最近更新 {latestDate}</span>}
      </p>
    </header>

    <section class="tag-index" aria-label="标签索引">
      <ul class="tag-list">
        {
          tagSummaries.map(({ tag, tagName, count, latestPost }) => (
            <li class="tag-item">
              <a href={`/tags/${tag}/`} class="tag-link">
                <span class="tag-name">{tagName}</span>
                <span class="tag-count">{count} 篇</span>
                {latestPost && (
                  <span class="tag-latest">
                    <span class="tag-latest-label">最近</span>
                    <span class="tag-latest-title">
                      {latestPost.data.title}
                    </span>
                    <time
                      datetime={new Date(
                        latestPost.data.pubDatetime
                      ).toISOString()}
                    >
                      {formatFullDate(
                        latestPost.data.pubDatetime,
                        SITE.timezone
                      )}
                    </time>
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</QuietLayout>

<style>
  .tags-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 2rem) 4rem;
  }

  .tags-hero {
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .tags-kicker {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--foreground);
    opacity: 0.64;
  }

  .tags-hero h1 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.08;
    font-family: var(--font-editorial);
    font-weight: 500;
    letter-spacing: 0.015em;
    color: var(--foreground);
  }

  .tags-hero p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--foreground);
    opacity: 0.64;
  }

  .tag-index {
    padding: 0.75rem 0 1.5rem;
  }

  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag-item {
    border-bottom: 1px solid var(--border-color);
  }

  .tag-item:last-child {
    border-bottom: none;
  }

  .tag-link {
    display: grid;
    grid-template-columns: minmax(8rem, 0.8fr) 4rem minmax(0, 1.7fr);
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.15rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .tag-link:hover {
    transform: translateX(2px);
  }

  .tag-link:hover .tag-name,
  .tag-link:hover .tag-latest-title {
    color: var(--accent);
  }

  .tag-name {
    min-width: 0;
    font-size: 1.125rem;
    line-height: 1.35;
    font-family: var(--font-editorial);
    font-weight: 500;
    color: var(--foreground);
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .tag-count {
    font-size: 0.8125rem;
    color: var(--foreground);
    opacity: 0.64;
    white-space: nowrap;
  }

  .tag-latest {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.625rem;
    align-items: baseline;
    color: var(--foreground);
  }

  .tag-latest-label,
  .tag-latest time {
    font-size: 0.75rem;
    opacity: 0.64;
    white-space: nowrap;
  }

  .tag-latest-title {
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    opacity: 0.72;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .separator {
    margin: 0 0.375rem;
    opacity: 0.4;
  }

  @media (max-width: 700px) {
    .tag-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
      align-items: start;
    }

    .tag-name {
      font-size: 1rem;
    }

    .tag-count {
      padding-top: 0.1rem;
      text-align: right;
    }

    .tag-latest {
      grid-column: 1 / -1;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.4rem 0.625rem;
    }

    .tag-latest time {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .tags-page {
      padding: 1.5rem 1rem 3rem;
    }

    .tags-hero {
      padding-bottom: 2rem;
    }

    .tags-hero h1 {
      font-size: 2.25rem;
    }
  }
</style>
