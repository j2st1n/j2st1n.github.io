---
import type { CollectionEntry } from "astro:content";
import ArticleList from "@/components/ArticleList.astro";
import QuietLayout from "@/themes/quiet/layouts/QuietLayout.astro";
import getPostsByTag from "@/utils/getPostsByTag";
import getUniqueTags from "@/utils/getUniqueTags";
import { getPublishedPosts } from "@/utils/getPublishedPosts";
import { formatFullDate } from "@/utils/date";
import { SITE } from "@/config";
type Props = {
  tagName: string;
  posts: CollectionEntry<"blog">[];
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getUniqueTags(posts);

  return tags.map(({ tag, tagName }) => ({
    params: { tag },
    props: { tagName, posts: getPostsByTag(posts, tag) },
  }));
}

const { tagName, posts } = Astro.props;
const latestDate = posts.length
  ? formatFullDate(
      posts[0].data.modDatetime ?? posts[0].data.pubDatetime,
      SITE.timezone
    )
  : "";
---

<QuietLayout
  title={`${tagName} | ${SITE.title}`}
  description={`包含标签「${tagName}」的所有文章。`}
>
  <main id="main-content" class="content-page">
    <header class="page-hero">
      <div class="hero-line">
        <p class="page-kicker">Tag</p>
        <a href="/tags/" class="all-tags-link">全部主题 →</a>
      </div>
      <h1>{tagName}</h1>
      <p>
        {posts.length} 篇文章
        {latestDate && <span> · 最近更新 {latestDate}</span>}
      </p>
    </header>

    <section class="post-index" aria-label={`${tagName} 标签文章列表`}>
      <ArticleList posts={posts} />
    </section>
  </main>
</QuietLayout>

<style>
  .content-page {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 2rem) 3rem;
    color: var(--foreground);
  }

  .page-hero {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-line {
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-kicker {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .all-tags-link {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .all-tags-link:hover {
    color: var(--accent);
    transform: translateX(0.125rem);
  }

  .page-hero h1 {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(2rem, 7vw, 4.5rem);
    font-family: var(--font-editorial);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  .page-hero p {
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .post-index {
    padding-top: 2rem;
  }

  @media (max-width: 640px) {
    .content-page {
      padding-top: 3.75rem;
    }

    .hero-line {
      align-items: center;
    }

    .all-tags-link {
      font-size: 0.8125rem;
    }

    .page-hero h1 {
      letter-spacing: 0.01em;
      text-wrap: wrap;
    }
  }
</style>
