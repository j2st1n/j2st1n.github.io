---
import ArticleList from "@/components/ArticleList.astro";
import QuietLayout from "@/themes/quiet/layouts/QuietLayout.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPublishedPosts } from "@/utils/getPublishedPosts";
import { formatFullDate } from "@/utils/date";
import { SITE } from "@/config";

const posts = await getPublishedPosts();
const sortedPosts = getSortedPosts(posts);
const latestDate = sortedPosts[0]
  ? formatFullDate(
      sortedPosts[0].data.modDatetime ?? sortedPosts[0].data.pubDatetime,
      SITE.timezone
    )
  : "";
---

<QuietLayout title={`全部文章 | ${SITE.title}`} description="全部文章。">
  <main id="main-content" class="content-page">
    <header class="page-hero">
      <p class="page-kicker">Posts</p>
      <h1>全部文章</h1>
      <p>
        共 {sortedPosts.length} 篇文章
        {latestDate && <span> · 最近更新 {latestDate}</span>}
      </p>
    </header>

    <section class="article-index" aria-label="全部文章索引">
      <ArticleList posts={sortedPosts} />
    </section>
  </main>
</QuietLayout>

<style>
  .content-page {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 2rem) 3rem;
    color: var(--foreground);
  }
  .page-hero {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .page-kicker {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .page-hero h1 {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(2rem, 7vw, 4.5rem);
    font-family: var(--font-editorial);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0.015em;
  }
  .page-hero p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  .article-index {
    padding: 2.25rem 0 0;
  }
  @media (max-width: 640px) {
    .content-page {
      padding-top: 3.75rem;
    }
  }
</style>
