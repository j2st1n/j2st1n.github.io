---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import SiteLogo from "@/components/SiteLogo.astro";
---

<header class="site-header" aria-label="站点导航">
  <div class="site-header-inner">
    <a href="/" class="site-brand" aria-label="bins.blog 首页">
      <SiteLogo class="brand-logo" />
      <span class="brand-name">bins.blog</span>
    </a>
    <nav class="site-tools" aria-label="站点工具">
      <a href="/search/" class="tool-link" title="搜索" aria-label="搜索">
        <IconSearch aria-hidden="true" />
      </a>
      <button
        id="theme-btn"
        class="theme-button"
        title="切换明暗主题"
        aria-label="切换明暗主题"
        aria-pressed="false"
      >
        <IconMoon class="theme-icon moon-icon" aria-hidden="true" />
        <IconSunHigh class="theme-icon sun-icon" aria-hidden="true" />
      </button>
    </nav>
  </div>
</header>
