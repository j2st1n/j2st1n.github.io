---
import Layout from "@/layouts/Layout.astro";
import QuietHeader from "../components/QuietHeader.astro";
import QuietFooter from "../components/QuietFooter.astro";
import "../styles/quiet.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonicalURL?: string | URL;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  showHeader?: boolean;
  footerMode?: "flow" | "none";
  isPost?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
  tags?: string[];
};

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  canonicalURL,
  pubDatetime,
  modDatetime,
  showHeader = true,
  footerMode = "flow",
  isPost = false,
  noindex = false,
  nofollow,
  tags,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  isPost={isPost}
  noindex={noindex}
  nofollow={nofollow}
  tags={tags}
>
  <div class="quiet-shell">
    {
      showHeader && (
        <a id="skip-to-content" href="#main-content" class="skip-link">
          跳到正文
        </a>
      )
    }
    {showHeader && <QuietHeader />}
    <div class="quiet-content">
      <slot />
    </div>
    {footerMode !== "none" && <QuietFooter />}
  </div>
</Layout>
