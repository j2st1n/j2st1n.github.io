---
import { type CollectionEntry, render } from "astro:content";
import Claps from "@/components/Claps.astro";
import QuoteShare from "@/components/QuoteShare.astro";
import QuietLayout from "./QuietLayout.astro";
import { SITE } from "@/config";
import {
  getGeneratedOgImageFileName,
  getPostOgImageVersion,
} from "@/utils/getOgImageVersion";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { formatFullDate } from "@/utils/date";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  tags,
  timezone: postTimezone,
  canonicalURL,
  ogImage,
} = post.data;
const displayTimezone = postTimezone ?? SITE.timezone;
const tocHeadings = headings.filter(
  heading => heading.depth === 2 || heading.depth === 3
);
const postIndex = posts.findIndex(item => item.id === post.id);
const prevPost = postIndex > 0 ? posts[postIndex - 1] : null;
const nextPost =
  postIndex >= 0 && postIndex < posts.length - 1 ? posts[postIndex + 1] : null;
const postNavClass = [
  "post-nav",
  prevPost && !nextPost ? "post-nav-only-prev" : "",
  nextPost && !prevPost ? "post-nav-only-next" : "",
]
  .filter(Boolean)
  .join(" ");

const updatedDate = modDatetime
  ? formatFullDate(modDatetime, displayTimezone)
  : null;
const postPath = getPath(post.id, post.filePath);
const postOgImage =
  typeof ogImage === "string"
    ? ogImage
    : (ogImage?.src ??
      `${postPath}${getGeneratedOgImageFileName(getPostOgImageVersion(post))}`);
---

<QuietLayout
  title={`${title} | ${SITE.title}`}
  headline={title}
  description={description}
  ogImage={postOgImage}
  ogImageAlt={title}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  tags={tags}
  isPost
>
  <main id="main-content" class="article-layout">
    <header class="article-hero">
      <h1 transition:name={slugifyStr(title.replaceAll(".", "-"))}>{title}</h1>
      <p>{description}</p>
      <div class="article-meta">
        <time datetime={new Date(pubDatetime).toISOString()}
          >{formatFullDate(pubDatetime, displayTimezone)}</time
        >
        {
          updatedDate && (
            <>
              <span class="separator">·</span>
              <span>更新 {updatedDate}</span>
            </>
          )
        }
        {
          tags.length > 0 && (
            <>
              <span class="separator">·</span>
              <span class="meta-tags">
                {tags.map(tag => (
                  <a href={`/tags/${slugifyStr(tag)}/`}>{tag}</a>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    {
      tocHeadings.length > 0 && (
        <nav class="article-toc" aria-label="文章目录">
          <p>目录</p>
          <ol>
            {tocHeadings.map(heading => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article
      id="article"
      class="article-body app-prose prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <QuoteShare
      title={title}
      pubDate={formatFullDate(pubDatetime, displayTimezone)}
    />

    <Claps slug={post.id} />

    <footer class="article-end" aria-label="文章页脚">
      <nav class={postNavClass} aria-label="上一篇和下一篇文章">
        {
          prevPost && (
            <a
              href={getPath(prevPost.id, prevPost.filePath)}
              class="post-nav-link post-nav-prev"
            >
              <span>上一篇</span>
              <strong>{prevPost.data.title}</strong>
            </a>
          )
        }
        {
          nextPost && (
            <a
              href={getPath(nextPost.id, nextPost.filePath)}
              class="post-nav-link post-nav-next"
            >
              <span>下一篇</span>
              <strong>{nextPost.data.title}</strong>
            </a>
          )
        }
      </nav>
    </footer>
  </main>
</QuietLayout>

<style>
  :global(html) {
    --article-width: var(--reading-width);
    --article-progress-line: var(--brand);
  }

  .article-layout {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 2rem) 4rem;
  }

  .article-hero,
  .article-body,
  .article-end {
    max-width: var(--article-width);
    margin-inline: auto;
  }

  .article-hero {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-hero h1 {
    color: var(--foreground);
    font-family: var(--font-editorial);
    font-size: clamp(2.35rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: 0.012em;
    text-wrap: balance;
    line-break: strict;
    overflow-wrap: anywhere;
  }

  .article-hero p {
    margin-top: 1.5rem;
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.75;
    text-wrap: pretty;
    line-break: strict;
    text-align: left;
    font-feature-settings:
      "chws" 1,
      "halt" 1;
    word-break: normal;
    overflow-wrap: anywhere;
    letter-spacing: 0.015em;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin-top: 1.65rem;
    color: var(--text-tertiary);
    font-family: var(--font-code);
    font-size: 0.76rem;
    letter-spacing: 0.025em;
  }

  .meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .meta-tags a {
    color: inherit;
    text-decoration: none;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .meta-tags a::before {
    content: "#";
    opacity: 0.42;
  }

  .meta-tags a:hover {
    color: var(--accent);
    opacity: 1;
  }

  .article-meta .separator {
    margin: 0 0.375rem;
  }

  .article-body {
    margin-top: 3.5rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  .article-body :global(p),
  .article-body :global(li) {
    line-height: 1.8;
    text-align: left;
    text-wrap: pretty;
    line-break: strict;
    font-feature-settings:
      "chws" 1,
      "halt" 1;
    word-break: normal;
    overflow-wrap: anywhere;
    letter-spacing: 0.015em;
  }

  .article-body :global(strong),
  .article-body :global(b) {
    color: var(--foreground);
    font-weight: 600;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4),
  .article-body :global(h5),
  .article-body :global(h6) {
    scroll-margin-top: 5rem;
    font-family: var(--font-editorial);
    font-weight: 500;
    letter-spacing: 0.012em;
  }

  .article-body :global(h2) {
    margin-top: 2.55em;
  }

  .article-body :global(h3) {
    margin-top: 2.15em;
  }

  .article-body :global(a) {
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }

  .article-body :global(p + ul),
  .article-body :global(p + ol) {
    margin-top: 1.15em;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-inline-start: 1.35em;
  }

  .article-body :global(li) {
    padding-inline-start: 0.15em;
  }

  .article-body :global(li > strong:first-child) {
    white-space: nowrap;
  }

  .article-body :global(blockquote) {
    border-inline-start-color: var(--border-color);
    color: color-mix(in oklch, var(--foreground), transparent 18%);
  }

  .article-body :global(hr) {
    border-color: var(--border-color);
  }

  .article-body :global(pre) {
    border: 1px solid var(--border-color);
    border-radius: 0.45rem;
  }

  .article-body :global(code) {
    font-family: var(--font-code);
  }

  :global(.article-progress-bar) {
    background: var(--article-progress-line);
  }

  :global(.copy-code) {
    opacity: 0.62;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;
  }

  :global(.copy-code:hover),
  :global(.copy-code:focus-visible) {
    border-color: var(--accent);
    opacity: 1;
  }

  .article-toc {
    display: none;
  }

  .article-toc p {
    margin: 0 0 0.65rem;
    color: var(--text-tertiary);
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.12em;
  }

  .article-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc li + li {
    margin-top: 0.35rem;
  }

  .article-toc a {
    display: block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    text-decoration: none;
    text-wrap: pretty;
    transition:
      color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .article-toc a:hover,
  .article-toc a:focus-visible,
  .article-toc a.active {
    color: var(--accent);
    font-weight: 500;
  }

  .article-toc a.active {
    transform: translateX(2px);
  }

  .article-toc .toc-depth-3 {
    padding-inline-start: 1.1rem;
  }

  .article-toc .toc-depth-3 a {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .article-toc .toc-depth-3 a.active {
    opacity: 1;
  }

  @media (min-width: 80rem) {
    .article-layout {
      position: relative;
    }

    .article-toc {
      display: block;
      position: fixed;
      top: 12.5rem;
      left: calc(50% + (var(--content-width) / 2) + 2.5rem);
      width: min(15rem, calc((100vw - var(--content-width)) / 2 - 4rem));
      max-height: calc(100svh - 14rem);
      overflow-y: auto;
      padding-inline-start: 1rem;
      border-inline-start: 1px solid var(--border-color);
      color: var(--foreground);
    }
  }

  .article-end {
    margin-top: 3.5rem;
    padding-top: 1.85rem;
    border-top: 1px solid var(--border-color);
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .post-nav-link {
    min-width: 0;
    max-width: 22rem;
    color: var(--foreground);
    text-decoration: none;
  }

  .post-nav-link span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-tertiary);
    font-family: var(--font-code);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .post-nav-link strong {
    display: block;
    color: var(--text-secondary);
    font-family: var(--font-editorial);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.65;
    text-wrap: pretty;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .post-nav-prev {
    grid-column: 1;
    justify-self: start;
  }

  .post-nav-next {
    grid-column: 2;
    justify-self: end;
    text-align: right;
  }

  .post-nav-link:hover strong,
  .post-nav-link:focus-visible strong {
    color: var(--accent);
  }

  .post-nav-prev:hover strong,
  .post-nav-prev:focus-visible strong {
    transform: translateX(-2px);
  }

  .post-nav-next:hover strong,
  .post-nav-next:focus-visible strong {
    transform: translateX(2px);
  }

  @media (max-width: 640px) {
    .article-layout {
      padding: 1.75rem 1.75rem 3rem;
    }

    .article-hero {
      padding: 3.2rem 0 2rem;
    }

    .article-hero h1 {
      font-size: clamp(2.15rem, 10vw, 3rem);
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    .article-hero p {
      font-size: 0.98rem;
    }

    .article-hero p,
    .article-body :global(p),
    .article-body :global(li) {
      text-wrap: wrap;
    }

    .article-body {
      margin-top: 2.6rem;
      font-size: 1rem;
    }

    .post-nav-link strong {
      text-wrap: wrap;
    }

    .post-nav {
      gap: 1.25rem;
    }

    .post-nav-link {
      max-width: 100%;
    }
  }

  @media (max-width: 360px) {
    .article-layout {
      padding: 1.25rem 1.25rem 3rem;
    }
  }
</style>

<script is:inline type="module" src="/scripts/article.js"></script>
