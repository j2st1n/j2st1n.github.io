---
type Props = {
  title: string;
  pubDate: string;
};

const { title, pubDate } = Astro.props;
---

<div id="quote-share-root" data-post-title={title} data-post-pub-date={pubDate}>
  <!-- 选词浮动气泡 (紧贴鼠标松开物理落点) -->
  <button
    id="quote-share-btn"
    type="button"
    class="quote-share-btn"
    aria-label="生成文摘卡片"
    style="display: none;"
  >
    <span class="btn-icon">🎴</span>
    <span class="btn-text">生成卡片</span>
  </button>

  <!-- 弹窗遮罩与卡片展示 -->
  <div
    id="quote-share-modal"
    class="quote-share-modal"
    style="display: none;"
    aria-hidden="true"
  >
    <div class="quote-share-backdrop" aria-hidden="true"></div>
    <div
      class="quote-share-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="quote-share-dialog-title"
      tabindex="-1"
    >
      <div class="quote-share-header">
        <span class="quote-share-title" id="quote-share-dialog-title"
          >🎴 纸质文摘卡片</span
        >
        <button
          type="button"
          class="quote-share-close"
          id="quote-share-close-btn"
          aria-label="关闭"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="quote-share-body">
        <div class="quote-img-container">
          <img
            id="quote-share-img"
            alt="文摘卡片"
            src=""
            class="quote-share-img"
          />
        </div>
      </div>

      <div class="quote-share-footer">
        <span class="quote-share-tip" aria-live="polite"
          >长按图片保存或分享</span
        >
        <div class="quote-share-actions">
          <button type="button" class="btn-action" id="quote-copy-btn">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              ></path>
            </svg>
            <span>复制图片</span>
          </button>
          <button
            type="button"
            class="btn-action btn-primary"
            id="quote-download-btn"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>下载卡片</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline type="module" src="/scripts/quote-share.js"></script>

<style>
  /* 紧贴鼠标落点的极简微型按钮 */
  .quote-share-btn {
    position: fixed;
    z-index: 1000;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    background: #1b365d;
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 14px rgba(27, 54, 93, 0.35);
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform 0.1s ease,
      background 0.1s;
    user-select: none;
    pointer-events: auto;
  }

  .quote-share-btn:hover {
    background: #132742;
    transform: translateX(-50%) translateY(-2px);
  }

  .quote-share-btn .btn-icon {
    font-size: 13px;
    line-height: 1;
  }

  .quote-share-btn .btn-text {
    letter-spacing: 0.02em;
  }

  /* 弹窗遮罩 */
  .quote-share-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .quote-share-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 19, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .quote-share-dialog {
    position: relative;
    z-index: 10;
    max-width: 460px;
    width: 100%;
    background: #faf9f5;
    border: 1px solid #e8e6dc;
    border-radius: 12px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .quote-share-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid #e8e6dc;
  }

  .quote-share-title {
    font-size: 14px;
    font-weight: 600;
    color: #1b365d;
  }

  .quote-share-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #7e796e;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quote-share-close:hover {
    color: #141413;
    background: #eae6db;
  }

  .quote-share-body {
    padding: 18px;
    display: flex;
    justify-content: center;
    background: #eeeae0;
    max-height: 68vh;
    overflow-y: auto;
  }

  .quote-img-container {
    max-width: 100%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }

  .quote-share-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .quote-share-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-top: 1px solid #e8e6dc;
    background: #faf9f5;
  }

  .quote-share-tip {
    font-size: 12px;
    color: #7e796e;
  }

  .quote-share-actions {
    display: flex;
    gap: 8px;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    color: #504e49;
    background: #f0ece1;
    border: 1px solid #dcd7c8;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-action:hover {
    background: #e5e0d4;
    color: #141413;
  }

  .btn-primary {
    background: #1b365d;
    color: #ffffff;
    border-color: #1b365d;
  }

  .btn-primary:hover {
    background: #132742;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .quote-share-dialog {
      max-width: 100%;
    }
    .quote-share-actions {
      flex: 1;
      justify-content: flex-end;
    }
  }
</style>
