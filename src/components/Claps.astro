---
import SiteLogo from "@/components/SiteLogo.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="claps-container" data-claps-root data-slug={slug}>
  <div class="claps-inner">
    <button
      type="button"
      class="clap-btn"
      data-clap-button
      aria-label="摸个鱼吧"
      title="摸个鱼吧"
    >
      <div class="stamp-icon" aria-hidden="true">
        <SiteLogo />
      </div>
      <span class="clap-count" data-clap-count>0</span>
      <span class="clap-bubble" data-clap-bubble aria-hidden="true">+1</span>
    </button>
    <p class="claps-hint" data-claps-hint>摸个鱼吧</p>
  </div>
</div>

<style>
  .claps-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
    display: flex;
    justify-content: center;
    user-select: none;
  }

  .claps-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .clap-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
  }

  .clap-btn:hover {
    border-color: color-mix(in oklch, var(--brand), var(--border-color) 40%);
    background: var(--surface-raised);
    color: var(--foreground);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px
      color-mix(in oklch, var(--foreground), transparent 94%);
  }

  .clap-btn:active {
    transform: scale(0.94);
  }

  .clap-btn.max-clapped {
    border-color: color-mix(in oklch, var(--brand), var(--border-color) 40%);
    background: var(--surface-raised);
    color: var(--foreground);
  }

  .clap-btn.max-clapped .stamp-icon {
    color: var(--brand);
  }

  .clap-btn.shake {
    animation: clap-shake 0.35s ease;
  }

  @keyframes clap-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .stamp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--text-secondary);
    transition:
      color 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .stamp-icon :global(.site-logo) {
    width: 100%;
    height: 100%;
  }

  .clap-btn:hover .stamp-icon,
  .clap-btn.stamped .stamp-icon {
    color: var(--brand); /* Kami 经典墨蓝 */
    transform: rotate(-6deg) scale(1.12);
  }

  .clap-count {
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
    min-width: 1.2ch;
  }

  .claps-hint {
    margin: 0;
    color: var(--text-tertiary);
    font-family: var(--font-editorial);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.85;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .claps-hint.maxed {
    color: var(--brand);
    opacity: 1;
    font-weight: 500;
  }

  /* 悬浮 +1 气泡动效：从数字上方轻盈升起，绝不遮挡左侧 Logo */
  .clap-bubble {
    position: absolute;
    top: -1.2rem;
    right: 0.6rem;
    transform: translateY(6px) scale(0.6);
    padding: 0.12rem 0.4rem;
    border-radius: 9999px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-code);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }

  .clap-bubble.pop {
    opacity: 1;
    transform: translateY(-12px) scale(1);
  }
</style>

<script is:inline type="module" src="/scripts/claps.js"></script>
