---
import SiteLogo from "@/assets/icons/SiteLogo.svg";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="claps-container" data-claps-root data-slug={slug}>
  <div class="claps-inner">
    <button
      type="button"
      class="clap-btn"
      data-clap-button
      aria-label="摸个鱼吧"
      title="摸个鱼吧"
    >
      <div class="stamp-icon" aria-hidden="true">
        <SiteLogo />
      </div>
      <span class="clap-count" data-clap-count>0</span>
      <span class="clap-bubble" data-clap-bubble aria-hidden="true">+1</span>
    </button>
    <p class="claps-hint">摸个鱼吧</p>
  </div>
</div>

<style>
  .claps-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
    display: flex;
    justify-content: center;
    user-select: none;
  }

  .claps-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .clap-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
  }

  .clap-btn:hover {
    border-color: color-mix(in oklch, var(--brand), var(--border-color) 40%);
    background: var(--surface-raised);
    color: var(--foreground);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--foreground), transparent 94%);
  }

  .clap-btn:active {
    transform: scale(0.94);
  }

  .stamp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--text-secondary);
    transition:
      color 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .stamp-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .clap-btn:hover .stamp-icon,
  .clap-btn.stamped .stamp-icon {
    color: var(--brand); /* Kami 经典墨蓝 */
    transform: rotate(-6deg) scale(1.12);
  }

  .clap-count {
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
    min-width: 1.2ch;
  }

  .claps-hint {
    margin: 0;
    color: var(--text-tertiary);
    font-family: var(--font-editorial);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  /* 悬浮 +1 气泡动效 */
  .clap-bubble {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(6px) scale(0.7);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-code);
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }

  .clap-bubble.pop {
    opacity: 1;
    transform: translateX(-50%) translateY(-10px) scale(1);
  }
</style>

<script>
  function initClaps() {
    const root = document.querySelector<HTMLElement>("[data-claps-root]");
    if (!root) return;

    const slug = root.dataset.slug;
    if (!slug) return;

    const button = root.querySelector<HTMLButtonElement>("[data-clap-button]");
    const countEl = root.querySelector<HTMLElement>("[data-clap-count]");
    const bubbleEl = root.querySelector<HTMLElement>("[data-clap-bubble]");
    if (!button || !countEl || !bubbleEl) return;

    const currentCountEl: HTMLElement = countEl;
    const currentBubbleEl: HTMLElement = bubbleEl;

    // API 地址支持全局环境变量覆盖，默认优雅降级为本地持久化与空连接
    const apiUrl =
      (window as any).__CLAPS_API_URL__ || "https://claps.bins.blog/api/claps";

    const storageKey = `claps:${slug}`;
    let currentTotal = 0;
    let pendingIncrement = 0;
    let syncTimeout: number | undefined;

    // 1. 读取服务器已有点赞
    async function fetchClaps() {
      try {
        const res = await fetch(`${apiUrl}?slug=${encodeURIComponent(slug!)}`, {
          method: "GET",
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          const data = await res.json();
          if (typeof data.claps === "number") {
            currentTotal = data.claps;
            currentCountEl.textContent = String(currentTotal);
          }
        } else {
          fallbackLocalRead();
        }
      } catch {
        fallbackLocalRead();
      }
    }

    function fallbackLocalRead() {
      const local = parseInt(localStorage.getItem(storageKey) || "0", 10);
      currentTotal = Math.max(currentTotal, local);
      currentCountEl.textContent = String(currentTotal);
    }

    // 2. 提交增量点赞 (带防抖合并)
    async function syncClaps() {
      if (pendingIncrement <= 0) return;
      const countToSend = pendingIncrement;
      pendingIncrement = 0;

      try {
        const res = await fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug, count: countToSend }),
        });
        if (res.ok) {
          const data = await res.json();
          if (typeof data.claps === "number") {
            currentTotal = data.claps;
            currentCountEl.textContent = String(currentTotal);
          }
        }
      } catch {
        // 网络异常时静默降级，不打扰阅读体验
      }
    }

    // 3. 点击盖印
    button.addEventListener("click", () => {
      currentTotal += 1;
      pendingIncrement += 1;
      currentCountEl.textContent = String(currentTotal);
      localStorage.setItem(storageKey, String(currentTotal));

      button.classList.add("stamped");

      // 弹出 +1 动画
      currentBubbleEl.textContent = `+${pendingIncrement}`;
      currentBubbleEl.classList.remove("pop");
      void currentBubbleEl.offsetWidth; // 触发 reflow
      currentBubbleEl.classList.add("pop");

      window.clearTimeout(syncTimeout);
      syncTimeout = window.setTimeout(() => {
        currentBubbleEl.classList.remove("pop");
        syncClaps();
      }, 800);
    });

    fetchClaps();
  }

  // 页面加载或 Astro 页面路由切换时重新初始化
  initClaps();
  document.addEventListener("astro:after-swap", initClaps);
</script>
